{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bombar.dev/schemas/specification.schema.json",
  "title": "BOMBAR specification metadata",
  "type": "object",
  "required": ["id", "title", "depends_on", "risk", "change_mode", "requires_live_probe", "acceptance_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,31}$"},
    "title": {"type": "string", "minLength": 1},
    "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "change_mode": {"enum": ["greenfield", "brownfield"]},
    "requires_live_probe": {"type": "boolean"},
    "acceptance_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^AC-[A-Z][A-Z0-9-]*$"}}
  },
  "additionalProperties": false
}
