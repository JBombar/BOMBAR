{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bombar.dev/schemas/project-profile.schema.json",
  "title": "BOMBAR project profile",
  "type": "object",
  "required": ["schema_version", "project", "execution", "approval"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "project": {
      "type": "object",
      "required": ["name", "state", "default_branch"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "state": {"enum": ["greenfield", "incubating", "live_brownfield", "legacy_unknown"]},
        "default_branch": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["spec_dir", "evidence_dir", "agent_adapter", "max_retries", "heartbeat_seconds", "auto_commit", "require_non_default_branch", "allow_live_actions_unattended", "gates"],
      "properties": {
        "spec_dir": {"type": "string"},
        "evidence_dir": {"type": "string"},
        "agent_adapter": {"type": "string"},
        "max_retries": {"type": "integer", "minimum": 0},
        "heartbeat_seconds": {"type": "integer", "minimum": 5},
        "auto_commit": {"type": "boolean"},
        "require_non_default_branch": {"type": "boolean"},
        "allow_live_actions_unattended": {"const": false},
        "gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "final_gates": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["additional_artifacts"],
      "properties": {"additional_artifacts": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
