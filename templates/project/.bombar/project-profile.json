{
  "schema_version": "0.1",
  "project": {
    "name": "replace-me",
    "state": "greenfield",
    "default_branch": "main"
  },
  "execution": {
    "spec_dir": "__development/bombar/specs",
    "evidence_dir": "__development/bombar/evidence",
    "agent_adapter": ".bombar/adapters/generic.sh",
    "max_retries": 1,
    "heartbeat_seconds": 30,
    "auto_commit": true,
    "require_non_default_branch": true,
    "allow_live_actions_unattended": false,
    "gates": [
      "BOMBAR_CONFIGURE_A_REAL_GATE"
    ],
    "protected_paths": [
      ".git/**",
      ".github/workflows/**",
      ".bombar/**",
      "BOMBAR.md",
      "__development/bombar/00_PRODUCT_BRIEF.md",
      "__development/bombar/01_REPOSITORY_ASSESSMENT.md",
      "__development/bombar/02_ARCHITECTURE.md",
      "__development/bombar/03_INVARIANTS.md",
      "__development/bombar/04_ACCEPTANCE_CONTRACT.md",
      "__development/bombar/05_IMPLEMENTATION_PLAN.md",
      "__development/bombar/specs/**",
      "__development/bombar/APPROVAL.json"
    ]
  },
  "approval": {
    "additional_artifacts": []
  }
}
